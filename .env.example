# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string used by the API at runtime.
# This points at the LEAST-PRIVILEGE sila_app role. It can SELECT/INSERT/UPDATE/
# DELETE on app tables, and SELECT/INSERT only on audit_log. Example for the
# local docker-compose database:
DATABASE_URL=postgres://sila_app:sila@localhost:5432/sila

# Admin connection string for migrations and the test suite's schema rebuilds.
# This should be the sila_owner role (or the local superuser for dev). Keep it
# out of the API's environment in production.
DATABASE_ADMIN_URL=postgres://sila_owner:sila@localhost:5432/sila

# 32-byte key-encryption key for the vault, base64url-encoded.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Never commit the real value.
SILA_KEK=

# Secret used to sign server-side session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Password for the seeded demo accounts. Must be at least 12 characters. The
# seed script refuses to run without it. Change this before any external share.
DEMO_PASSWORD=

# When "true", the landing page shows the demo panel with one-click sign-in
# for the three named demo accounts and a reset button. Keep false (or unset)
# in production.
DEMO_MODE=
