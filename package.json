{
  "name": "sila",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:server": "tsc -p server/tsconfig.build.json",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "synthetic": "tsx scripts/generate-synthetic.ts",
    "server:dev": "tsx --env-file-if-exists=.env server/src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/db-migrate.ts",
    "db:push": "drizzle-kit push",
    "audit:verify": "tsx --env-file-if-exists=.env scripts/audit-verify.ts",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "review:export": "tsx scripts/review-export.ts",
    "clinician:import": "tsx --env-file-if-exists=.env scripts/clinician-import.ts",
    "attack": "tsx attack/index.ts",
    "kek:rotate": "tsx --env-file-if-exists=.env scripts/kek-rotate.ts",
    "test:e2e": "playwright test",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "next": "^16.4.5",
    "pg": "^8.23.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "supertest": "^7.3.2",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
