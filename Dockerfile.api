# Multi-stage build for the Express API. Runs with tsx at startup (same as
# server:dev). We ship the TypeScript sources plus node_modules; no pre-
# compile step is needed since tsx is a dev dep in package.json.

FROM node:20-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:20-bookworm-slim AS run
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=4000
COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json tsconfig.json drizzle.config.ts ./
COPY server ./server
COPY src ./src
COPY scripts ./scripts
COPY drizzle ./drizzle
COPY data ./data
EXPOSE 4000
CMD ["npx", "tsx", "server/src/index.ts"]
