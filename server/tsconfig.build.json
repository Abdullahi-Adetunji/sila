{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "declaration": false,
    "outDir": "./dist",
    "rootDir": "..",
    "baseUrl": "..",
    "paths": {
      "@/*": ["./src/*"]
    },
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": [
    "./src/**/*.ts",
    "../src/lib/genetics/**/*.ts",
    "../src/content/**/*.ts"
  ],
  "exclude": [
    "./src/**/*.test.ts",
    "./src/test/**",
    "./src/types/pglite.d.ts"
  ]
}
